# Build-time settings for `bun run dev`. Defaults match `plat5 start`.
# The container image takes the same settings at start, without VITE_ (see README).

# Gateway (Plat5 edge)
VITE_GATEWAY_URL=http://localhost:5400

# Plat5 Auth (OIDC issuer)
VITE_AUTH_ISSUER=http://localhost:5401
VITE_AUTH_CLIENT_ID=plat5
VITE_AUTH_REDIRECT_URI=http://localhost:3001/callback

# Optional audience (OpenAuth authorize param). Leave empty if unused.
# VITE_AUTH_AUDIENCE=plat5

# Claim holding the IdP subject (same as the gateway's AUTH_SUBJECT_CLAIM).
# VITE_AUTH_SUBJECT_CLAIM=properties.user_id

# Where the gateway answers route checks (route_checks.path in plat5.yml).
# VITE_ROUTE_CHECKS_PATH=/access/routes
